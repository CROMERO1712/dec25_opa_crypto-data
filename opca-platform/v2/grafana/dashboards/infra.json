    {
      "type": "row",
      "title": "Conteneurs",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Conteneurs : mémoire et CPU (maintenant)",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "opca-prom"
      },
      "description": "Mémoire utilisée, limite fixée dans docker compose et part de la limite. Au-delà de 90 % de sa limite, un conteneur risque d'être tué par le système (OOM).",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opca-prom"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".+\"})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "opca-prom"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (name) (container_spec_memory_limit_bytes{name=~\".+\"}) > 0"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "opca-prom"
          },
          "format": "table",
          "instant": true,
          "expr": "100 * sum by (name) (container_memory_working_set_bytes{name=~\".+\"}) / (sum by (name) (container_spec_memory_limit_bytes{name=~\".+\"}) > 0)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "opca-prom"
          },
          "format": "table",
          "instant": true,
          "expr": "100 * sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[5m]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Conteneur",
              "Value #A": "Mémoire utilisée",
              "Value #B": "Limite",
              "Value #C": "% de la limite",
              "Value #D": "CPU (% d'un cœur)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "% de la limite",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Mémoire utilisée"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Limite"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (% d'un cœur)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% de la limite"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "timeseries",
      "title": "Mémoire par conteneur (8 plus gros)",
