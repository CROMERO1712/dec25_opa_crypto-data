    {
      "type": "timeseries",
      "title": "Réseau des conteneurs",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "opca-prom"
      },
      "description": "Trafic réseau de l'ensemble des conteneurs (collecte des prix, API, Grafana...).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opca-prom"
          },
          "expr": "sum(rate(container_network_receive_bytes_total{name=~\".+\"}[5m]))",
          "legendFormat": "reçu"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "opca-prom"
          },
          "expr": "sum(rate(container_network_transmit_bytes_total{name=~\".+\"}[5m]))",
